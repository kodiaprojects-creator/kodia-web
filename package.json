{
  "name": "kodia-web",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build:css": "tailwindcss -i ./css/input.css -o ./css/kodia.css --minify",
    "build:faqs": "node scripts/build-faqs.mjs",
    "watch:css": "tailwindcss -i ./css/input.css -o ./css/kodia.css --watch",
    "build": "npm run build:faqs && npm run build:css"
  },
  "dependencies": {
    "resend": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "tailwindcss": "^3.4.19"
  }
}
